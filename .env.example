# ─────────────────────────────────────────────────────────────────────────────
# Bylaw environment. Copy to `.env.local` and fill in. NEVER commit real secrets.
# See PRODUCTION.md for what each mode requires.
# ─────────────────────────────────────────────────────────────────────────────

# Public app URL (used for receipt links, auth message domain).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solana cluster the app targets. Safe default is devnet.
# devnet | testnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Explorer cluster query value (usually mirrors the network; blank for mainnet).
NEXT_PUBLIC_SOLANA_EXPLORER_CLUSTER=devnet

# ── Supabase (optional today; REQUIRED for production server data layer) ──
# With both set, the app persists to Supabase instead of the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only secrets (REQUIRED for the production auth + data layer) ──
# Do NOT prefix with NEXT_PUBLIC_ — these must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=
SOLANA_COMMITMENT=confirmed
# 32+ char random strings, e.g. `openssl rand -hex 32`
SESSION_SECRET=
AUTH_NONCE_SECRET=

# ── Observability (optional) ──
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
